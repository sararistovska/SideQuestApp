@model SideQuestApp.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="sq-category-form-page">
    
    <a asp-controller="Category"
       asp-action="Index"
       class="sq-back-link">
        Back to categories
    </a>

    <div class="sq-category-form-header">
        <span class="sq-label">ADMIN · CATEGORIES</span>
        <h1>Create category</h1>
        <p>
            Add a new category that can be used to organize quests.
        </p>
    </div>

    <div class="sq-category-form-card">

        <div class="sq-category-admin-mark">
            CATEGORY SETUP
        </div>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="sq-category-form-error"></div>

            <div class="sq-category-form-group">
                <label asp-for="Name"></label>

                <input asp-for="Name"
                       placeholder="e.g. Nature, Fitness, Creativity"/>

                <span asp-validation-for="Name"
                      class="sq-category-form-error"></span>
            </div>

            <div class="sq-category-form-group">
                <label asp-for="Description"></label>

                <textarea asp-for="Description"
                          placeholder="Describe what kind of quests belong here..."></textarea>

                <span asp-validation-for="Description"
                      class="sq-category-form-error"></span>
            </div>

            <div class="sq-category-form-actions">

                <a asp-action="Index"
                   class="sq-category-form-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="sq-button sq-button-primary">
                    Create category
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}